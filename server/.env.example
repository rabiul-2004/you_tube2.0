# Server configuration - copy this file to .env and fill in your own values
# Do NOT commit the real .env file.

# Port the API server listens on (defaults to 5000)
PORT=5000

# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/yourtube
DB_URL=mongodb://127.0.0.1:27017/yourtube

# Razorpay keys - https://dashboard.razorpay.com/app/keys (use TEST keys while developing)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email (OTP + invoice) — RECOMMENDED (reliable from any host, incl. Render): Brevo HTTP API.
# It uses HTTPS port 443 — bypasses any SMTP port-587 egress blocking.
# 1) Get a v3 API KEY: https://app.brevo.com -> SMTP & API -> API Keys -> Generate (starts with xkeysib-)
# 2) Verify a SENDER EMAIL: Senders & IPs -> Senders -> Add a Sender (no domain needed).
# 3) MAIL_FROM must be that exact verified sender email.
BREVO_API_KEY=xkeysib-xxxxxxxxxxxx
MAIL_FROM=YourTube <that-verified-sender-email>

# Alternative: plain SMTP (fallback if BREVO_API_KEY is unset) — Brevo SMTP relay:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=b700be001@smtp-brevo.com
# SMTP_PASS=your-brevo-smtp-key

# Gmail SMTP (needs App Password; unreliable from cloud/datacenter IPs — avoid in production)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-gmail-app-password
# MAIL_FROM=YourTube <noreply@yourtube.dev>

# Optional: absolute path to the Firebase service-account JSON.
# If unset, the server looks for server/firebase-service-account.json (gitignored).
# FIREBASE_SERVICE_ACCOUNT=

# Cloudinary - video storage (upload preset must be "Signed" with folder "yourtube")
# IMPORTANT: API Key and API Secret must be from the SAME key pair (Settings → API Keys)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
